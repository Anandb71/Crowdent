# Copy to `.env` on a research machine. Never commit the filled file.

# JWT signing secret for local sessions. Generate a long random value.
CROWDENT_SESSION_SECRET=

# Optional TOTP issuer label shown in authenticators.
CROWDENT_TOTP_ISSUER=Crowdent

# Leave empty to keep the loopback default.
CROWDENT_BIND_HOST=127.0.0.1
